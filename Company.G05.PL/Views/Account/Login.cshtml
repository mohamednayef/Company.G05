@model LoginDto
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
 
<div class="main-agileinfo">
    <div class="agileits-top">
        
        <div asp-validation-summary="All" class="alert alert-danger m-3"></div>
        
        <form asp-action="Login" method="post">
            <input class="text email" asp-for="Email" placeholder="Email" required="">
            <input class="text" asp-for="Password" placeholder="Password" required="">
            <div class="wthree-text">
                <label class="anim">
                    <input asp-for="RememberMe" class="checkbox">
                    <span>Remeber Me</span>
                </label>
                <div class="clear"> </div>
            </div>
            <input type="submit" value="LOGIN">
        </form>
        <p>Do not have an Account! <a asp-action="SignUp">CREATE NEW ACCOUNT</a></p>
    </div>
</div>

